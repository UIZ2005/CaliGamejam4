  m_Script: {fileID: 11500000, guid: 94f529b04d81495408c2466af94d0cde, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Diaologo
  nombreNpc: Don Eusebio
  dialogopanel: {fileID: 393737604}
  viejito: {fileID: 1573793663}
  texto: {fileID: 1416526022}
  lineasDialogo:
  - "Eso, carajo! \xBFVieron que s\xED eran capaces? De a poquitos se levanta una
    casa y, entre todos, se levanta un barrio"
  - "Bueno, muchachos, hasta aqu\xED llega mi explicaci\xF3n. Les deseo suerte en
    las pr\xF3ximas hornadas\u2026 \xA1y no me vayan a dejar esa olla pegada!"
