--- !u!114 &369036477
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 369036475}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94f529b04d81495408c2466af94d0cde, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Diaologo
  nombreNpc: Don Eusebio
  dialogopanel: {fileID: 1745339639}
  viejito: {fileID: 1888629282}
  texto: {fileID: 570003696}
  lineasDialogo:
  - "Ave Mar\xEDa, muchachos! \xA1Miren nom\xE1s esa belleza! \xA1Dejaron a Cali
    m\xE1s bonita que nunca!"
  - "Reconstruyeron hasta la Ermita, esos monumentos volvieron a brillar. Y todo
    gracias a ustedes, \xA1qu\xE9 verraquera!"
  - "Ya ven lo que se logra cuando se trabaja en equipo? Unos ponen la comida, otros
    ponen el ladrillo, \xA1y entre todos levantamos hasta el \xE1nimo de una ciudad!"
  typingtext: 0.05
