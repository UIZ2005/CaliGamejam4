--- !u!114 &1498174044
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1498174042}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94f529b04d81495408c2466af94d0cde, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Diaologo
  nombreNpc: Don Eusebio
  dialogopanel: {fileID: 393737604}
  viejito: {fileID: 1573793663}
  texto: {fileID: 1416526022}
  lineasDialogo:
  - "\xBFVieron? \xA1Con la barriga llena se trabaja mejor! No se les olvide comer,
    porque si se quedan sin energ\xEDa, hasta ah\xED les llega el camello"
  - "Bueno, ahora s\xED, \xA1vamos a levantar esa casita!"
  - "P\xF3nganme cuidado, maestros. Vayan a la mesa de trabajo: ah\xED les van a
    mostrar qu\xE9 materiales necesitan pa' cada construcci\xF3n"
