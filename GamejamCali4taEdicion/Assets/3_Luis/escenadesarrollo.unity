  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94f529b04d81495408c2466af94d0cde, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Diaologo
  nombreNpc: Don Eusebio
  dialogopanel: {fileID: 393737604}
  viejito: {fileID: 1573793663}
  texto: {fileID: 1416526022}
  lineasDialogo:
  - "Eso es, ve! Esa arepita qued\xF3 una nota. Pero no se me duerman, que ya viene
    gente con hambre"
  - "Cuando lleguen los vecinos, preparen sus pedidos y s\xEDrvanles la comida. Que
    aqu\xED nadie se nos quede con el est\xF3mago vac\xEDo"
  - Cojan un plato para servir esa arepa y llevensela al vecino
