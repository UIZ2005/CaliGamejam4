--- !u!114 &1329516339
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1329516337}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94f529b04d81495408c2466af94d0cde, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Diaologo
  nombreNpc: Don Eusebio
  dialogopanel: {fileID: 393737604}
  viejito: {fileID: 1573793663}
  texto: {fileID: 1416526022}
  lineasDialogo:
  - "Quiubo, muchachos! Vean el chicharr\xF3n en el que estamos metidos\u2026 \xA1La
    casa se nos vino abajo y el barrio necesita una mano"
  - "Pero tranquilos, que aqu\xED nadie se vara. Uno cocina y el otro mete ladrillo.
    \xA1Entre los dos sacamos esto adelante"
  - "p\xF3ngase las pilas!, vayan y cogan unas arepas para azarlas, y cuidado que
    se les pueden quemar"
